# Beans Proxy configuration

# Upstream target. Treated as a base URL; the proxy forwards the full caller path.
BEANS_PROXY_TARGET_URL=https://openrouter.ai/api/v1
BEANS_PROXY_TARGET_API_KEY=sk-or-v1-replace-me

# Port the proxy listens on
BEANS_PROXY_PORT=8000

# Host the proxy binds to
BEANS_PROXY_HOST=127.0.0.1

# Directory where per-key token usage files are stored
BEANS_PROXY_USAGE_DIR=token_usage

# Log file location
BEANS_PROXY_LOG_FILE=beans_proxy.log
